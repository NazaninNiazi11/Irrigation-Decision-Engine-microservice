# Database
DATABASE_URL=postgresql://irrigation_user:irrigation_pass@db:5432/irrigation_db

# Auth
SECRET_KEY=dev-secret-key-change-in-production

# OpenRouter (AI explanation)
# Get a key at https://openrouter.ai/keys
# Leave OPENROUTER_API_KEY blank to disable AI explanations (rule-based fallback will be used).
OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-haiku-4.5
